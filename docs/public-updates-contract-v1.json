  "definitions": {
    "public_update_date": "Intentional publication time of a user-meaningful GymMap change.",
    "confirmation_date": "Date GymMap checked the source supporting a specific fact or schedule.",
    "freshness": "Domain-owned policy result; Public Updates and shared UI do not calculate it.",
    "internal_process_date": "Crawler, import, monitor, build, deploy, or migration execution time; not a public update by itself.",
    "effective_or_source_period": "Optional date or period the changed content concerns, distinct from published_at."
  },
  "semantic_invariants": [
    "public update != confirmation date",
    "public update != freshness badge",
    "public update != internal process execution",
    "same-content re-import is not a public update",
    "HYROX missing or empty positive evidence is not negative evidence",
    "Public Updates consumes and never redefines Lesson or HYROX freshness",
    "site-wide last updated is prohibited without aggregate completeness authority"
  ],
