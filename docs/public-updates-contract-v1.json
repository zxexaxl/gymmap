  "publication_modes": {
    "AUTO_SAFE": {
      "authorized_event_classes": [],
      "status": "NO_CURRENT_CLASS_AUTHORIZED"
    },
    "EDITORIAL_REVIEW": {
      "required_for": [
        "Lesson data updates",
        "HYROX data updates",
        "material data corrections",
        "data-driven grouping and wording"
      ]
    },
    "MANUAL": {
      "required_for": ["Product and feature announcements", "exceptional corrections or retractions"]
    },
    "NOT_PUBLISHABLE": {
      "applies_to": [
        "same-content refresh",
        "crawler or import execution",
        "monitor execution or no-change result",
        "build or deployment",
        "migration or refactor"
      ]
    }
  },
  "grouping": {
    "unit": "one reviewed user-meaningful change group",
    "dimensions": [
      "category or domain",
      "domain-approved semantic change type",
      "public-safe source or brand scope",
      "effective or source period",
      "affected entity set",
      "reviewed publication batch"
    ],
    "clock_only_window": null,
    "clock_only_grouping_prohibited": true,
    "membership_authority": "reviewed publication_batch_id",
    "counts": {
